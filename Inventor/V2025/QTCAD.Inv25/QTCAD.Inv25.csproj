<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows8.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <RootNamespace>QTCAD.Inv25</RootNamespace>
    <AssemblyName>QTCAD.Inv25</AssemblyName>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <SupportedOSPlatformVersion>8.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**" />
    <EmbeddedResource Include="**\*.resx" Exclude="bin\**;obj\**" />
    <None Include="Properties\launchSettings.json" />
    <None Include="QTCAD.Inv25.X.manifest" />
    <None Include="QTCAD.Inv25.addin" />
    <None Include="Readme.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\QTCAD.API\QTCAD.API.csproj" />
    <ProjectReference Include="..\..\..\QTCAD.Common\QTCAD.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath Condition="Exists('$(ProgramFiles)\Autodesk\Inventor 2025\Bin\Autodesk.Inventor.Interop.dll')">$(ProgramFiles)\Autodesk\Inventor 2025\Bin\Autodesk.Inventor.Interop.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <Target Name="EmbedManifest" AfterTargets="Build">

    <PropertyGroup>
      <WindowsSdkRoot>C:\Program Files (x86)\Windows Kits\10</WindowsSdkRoot>
      <MtExe>$(WindowsSdkRoot)\bin\10.0.22621.0\x64\mt.exe</MtExe>
    </PropertyGroup>

    <Error
      Condition="!Exists('$(MtExe)')"
      Text="Windows SDK mt.exe was not found: $(MtExe)" />

    <Message
      Importance="High"
      Text="Using mt.exe: $(MtExe)" />

    <Exec
      Command="&quot;$(MtExe)&quot; -manifest &quot;$(ProjectDir)QTCAD.Inv25.X.manifest&quot; -outputresource:&quot;$(TargetPath)&quot;;#2" />

  </Target>

  <Target Name="DeployInventorAddin" AfterTargets="EmbedManifest">

    <PropertyGroup>
      <InventorAddinDir>$(APPDATA)\Autodesk\Inventor 2025\Addins\QTCAD.Inv25</InventorAddinDir>
    </PropertyGroup>

    <MakeDir Directories="$(InventorAddinDir)" />

    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(InventorAddinDir)"
      SkipUnchangedFiles="true" />

    <Copy
      Condition="Exists('$(TargetDir)QTCAD.API.dll')"
      SourceFiles="$(TargetDir)QTCAD.API.dll"
      DestinationFolder="$(InventorAddinDir)"
      SkipUnchangedFiles="true" />

    <Copy
      Condition="Exists('$(TargetDir)QTCAD.Common.dll')"
      SourceFiles="$(TargetDir)QTCAD.Common.dll"
      DestinationFolder="$(InventorAddinDir)"
      SkipUnchangedFiles="true" />

    <Copy
      SourceFiles="$(ProjectDir)QTCAD.Inv25.addin"
      DestinationFolder="$(InventorAddinDir)"
      SkipUnchangedFiles="true" />

    <Copy
      Condition="Exists('$(TargetPath).pdb')"
      SourceFiles="$(TargetPath).pdb"
      DestinationFolder="$(InventorAddinDir)"
      SkipUnchangedFiles="true" />

    <Message
      Importance="High"
      Text="QTCAD.Inv25 deployed to $(InventorAddinDir)" />

  </Target>

</Project>